-- BOX FUNCTION
local function createBox(y,text,default)

	local box = Instance.new("TextBox")
	box.Parent = main
	box.Size = UDim2.new(0,240,0,38)
	box.Position = UDim2.new(0.5,-120,0,y)
	box.PlaceholderText = text
	box.Text = default or ""
	box.Font = Enum.Font.GothamSemibold
	box.TextSize = 16
	box.TextColor3 = Color3.new(1,1,1)
	box.BackgroundColor3 = Color3.fromRGB(35,35,35)
	box.BorderSizePixel = 0

	Instance.new("UICorner",box).CornerRadius = UDim.new(0,12)

	return box
end

local imageBox = createBox(55,"Image ID","")
local sizeBox = createBox(105,"Cursor Size","50")
local posBox = createBox(155,"Move Up Amount","0")

-- BUTTON FUNCTION
local function createButton(text,x,color)

	local btn = Instance.new("TextButton")
	btn.Parent = main
	btn.Size = UDim2.new(0,110,0,42)
	btn.Position = UDim2.new(0,x,0,215)
	btn.Text = text
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 18
	btn.TextColor3 = Color3.new(1,1,1)
	btn.BackgroundColor3 = color
	btn.BorderSizePixel = 0

	Instance.new("UICorner",btn).CornerRadius = UDim.new(0,14)

	return btn
end

local loadBtn = createButton("Load",20,Color3.fromRGB(0,170,255))
local toggleBtn = createButton("OFF",160,Color3.fromRGB(255,70,70))

-- CURSOR
local cursor = Instance.new("ImageLabel")
cursor.Parent = gui
cursor.BackgroundTransparency = 1
cursor.Size = UDim2.new(0,50,0,50)
cursor.Visible = false
cursor.ZIndex = 999999

local enabled = false

-- LOAD
loadBtn.MouseButton1Click:Connect(function()

	local id = imageBox.Text:gsub("%D","")

	if id ~= "" then
		cursor.Image = "rbxthumb://type=Asset&id="..id.."&w=420&h=420"
	end

	local size = tonumber(sizeBox.Text)

	if size then
		cursor.Size = UDim2.new(0,size,0,size)
	end

end)

-- TOGGLE
local function update()

	if enabled then
		toggleBtn.Text = "ON"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(0,220,120)
	else
		toggleBtn.Text = "OFF"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(255,70,70)
	end
end

update()

toggleBtn.MouseButton1Click:Connect(function()

	enabled = not enabled
	cursor.Visible = enabled
	update()

end)

UIS.MouseIconEnabled = false

-- ONLY SHOW IN SHIFTLOCK
RunService.RenderStepped:Connect(function()

	if enabled and UIS.MouseBehavior == Enum.MouseBehavior.LockCenter then

		cursor.Visible = true

		local size = cursor.AbsoluteSize.X
		local center = size / 2
		local up = tonumber(posBox.Text) or 0

		cursor.Position = UDim2.new(
			0.5,
			-center,
			0.5,
			-center - up
		)

	else

		cursor.Visible = false

	end
end)

