-- BUTTON FUNCTION
local function createButton(text,x,color)

	local btn = Instance.new("TextButton")
	btn.Parent = main
	btn.Size = UDim2.new(0,110,0,42)
	btn.Position = UDim2.new(0,x,0,215)
	btn.Text = text
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 18
	btn.TextColor3 = Color3.new(1,1,1)
	btn.BackgroundColor3 = color
	btn.BorderSizePixel = 0
	btn.AutoButtonColor = false

	Instance.new("UICorner",btn).CornerRadius = UDim.new(0,14)

	btn.MouseEnter:Connect(function()

		TweenService:Create(
			btn,
			TweenInfo.new(0.15),
			{Size = UDim2.new(0,115,0,45)}
		):Play()

	end)

	btn.MouseLeave:Connect(function()

		TweenService:Create(
			btn,
			TweenInfo.new(0.15),
			{Size = UDim2.new(0,110,0,42)}
		):Play()

	end)

	return btn
end

local loadBtn = createButton("Load",20,Color3.fromRGB(0,170,255))
local toggleBtn = createButton("OFF",160,Color3.fromRGB(255,70,70))

-- CURSOR
local cursor = Instance.new("ImageLabel")
cursor.Parent = gui
cursor.BackgroundTransparency = 1
cursor.Size = UDim2.new(0,50,0,50)
cursor.Visible = false
cursor.ZIndex = 999999

local enabled = false

-- LOAD SETTINGS
loadBtn.MouseButton1Click:Connect(function()

	local id = imageBox.Text:gsub("%D","")

	if id ~= "" then
		cursor.Image = "rbxthumb://type=Asset&id="..id.."&w=420&h=420"
	end

	local size = tonumber(sizeBox.Text)

	if size then
		cursor.Size = UDim2.new(0,size,0,size)
	end

	TweenService:Create(
		loadBtn,
		TweenInfo.new(0.1),
		{Rotation = 5}
	):Play()

	task.wait(0.1)

	TweenService:Create(
		loadBtn,
		TweenInfo.new(0.1),
		{Rotation = 0}
	):Play()

end)

-- TOGGLE
local function update()

	if enabled then

		toggleBtn.Text = "ON"

		TweenService:Create(
			toggleBtn,
			TweenInfo.new(0.2),
			{BackgroundColor3 = Color3.fromRGB(0,220,120)}
		):Play()

	else

		toggleBtn.Text = "OFF"

		TweenService:Create(
			toggleBtn,
			TweenInfo.new(0.2),
			{BackgroundColor3 = Color3.fromRGB(255,70,70)}
		):Play()

	end
end

update()

toggleBtn.MouseButton1Click:Connect(function()

	enabled = not enabled
	cursor.Visible = enabled
	update()

end)

UIS.MouseIconEnabled = false

-- CURSOR FOLLOW
RunService.RenderStepped:Connect(function()

	if enabled then

		local size = cursor.AbsoluteSize.X
		local center = size / 2
		local up = tonumber(posBox.Text) or 0

		if UIS.MouseBehavior == Enum.MouseBehavior.LockCenter then

			cursor.Position = UDim2.new(
				0.5,
				-center,
				0.5,
				-center - up
			)

		else

			cursor.Position = UDim2.new(
				0,
				mouse.X - center,
				0,
				mouse.Y - center - up
			)

		end
	end
end)

